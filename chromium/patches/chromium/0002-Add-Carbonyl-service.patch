+        CreateSkFont(false, &font_description_)
+    );
+
+    if (node_id != cc::kInvalidNodeId) {
+      canvas->drawTextBlob(blob, point.x(), point.y(), node_id, flags);
+    } else {
+      canvas->drawTextBlob(blob, point.x(), point.y(), flags);
