+// Carbonyl: when text mode is on, Font::DrawText already emits base64-encoded
+// raw text via its own path. Bloberizer-based callers (DrawEmphasisMarks,
+// plain_text_painter) would re-emit shaped glyphs on top, so short-circuit.
+static const bool carbonyl_b64_text = true;
+
 void DrawTextBlobs(const ShapeResultBloberizer::BlobBuffer& blobs,
                    cc::PaintCanvas& canvas,
                    const gfx::PointF& point,
                    const cc::PaintFlags& flags,
                    cc::NodeId node_id) {
