diff --git a/headless/lib/browser/headless_platform_delegate_aura.cc b/headless/lib/browser/headless_platform_delegate_aura.cc
index 27e374414c7d0..342e63c80d95e 100644
--- a/headless/lib/browser/headless_platform_delegate_aura.cc
+++ b/headless/lib/browser/headless_platform_delegate_aura.cc
@@ -14,6 +14,9 @@
 #include "ui/aura/env.h"
 #include "ui/aura/window.h"
 #include "ui/display/screen.h"
+#include "ui/gfx/geometry/rect_conversions.h"
+
+#include "carbonyl/src/browser/bridge.h"
 #include "ui/events/devices/device_data_manager.h"
 #include "ui/gfx/geometry/rect.h"
 #include "ui/gfx/native_ui_types.h"
@@ -62,8 +65,10 @@ void HeadlessPlatformDelegate::SetWebContentsBounds(
     native_view->SetBounds(bounds);
   }
 
-  // Update RootWindow.
-  web_contents->window_tree_host()->SetBoundsInPixels(bounds);
+  // Update RootWindow. Scale logical bounds to physical pixels using Carbonyl's
+  // DPI so the window-tree-host matches the terminal cell grid.
+  web_contents->window_tree_host()->SetBoundsInPixels(
+      gfx::ScaleToEnclosedRect(bounds, carbonyl::Renderer::GetDPI()));
 }
 
 ui::Compositor* HeadlessPlatformDelegate::GetCompositor(
diff --git a/headless/lib/browser/headless_screen.cc b/headless/lib/browser/headless_screen.cc
index 0f39e4f7132fe..03e126ba80525 100644
--- a/headless/lib/browser/headless_screen.cc
+++ b/headless/lib/browser/headless_screen.cc
@@ -18,6 +18,8 @@
 
 #if defined(USE_AURA)
 #include "ui/aura/window.h"
+
+#include "carbonyl/src/browser/bridge.h"
 #endif
 
 using display::Display;
@@ -88,8 +90,12 @@ void HeadlessScreen::CreateDisplayList(const gfx::Size& window_size,
                                        std::string_view screen_info_spec) {
   std::vector<HeadlessScreenInfo> screen_info;
   if (screen_info_spec.empty()) {
-    screen_info.push_back(
-        HeadlessScreenInfo({.bounds = gfx::Rect(window_size)}));
+    // Carbonyl: use the terminal's DPI as the display's device pixel ratio so
+    // logical pixels map cleanly onto cell-grid dimensions.
+    screen_info.push_back(HeadlessScreenInfo({
+        .bounds = gfx::Rect(window_size),
+        .device_pixel_ratio = carbonyl::Renderer::GetDPI(),
+    }));
   } else {
     screen_info = HeadlessScreenInfo::FromString(screen_info_spec).value();
     CHECK(!screen_info.empty());
