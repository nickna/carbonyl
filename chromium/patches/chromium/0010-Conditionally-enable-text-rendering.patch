From 0482a53485e306503b11aa5aa12e8a8798f199ca Mon Sep 17 00:00:00 2001
From: Fathy Boundjadj <hey@fathy.fr>
Date: Sun, 12 Feb 2023 00:55:33 +0100
Subject: [PATCH 10/16] Conditionally enable text rendering

---
 content/renderer/render_frame_impl.cc         |  3 +-
 .../core/css/resolver/style_resolver.cc       | 30 +++++++++++--------
 third_party/blink/renderer/platform/BUILD.gn  |  1 +
 .../blink/renderer/platform/fonts/font.cc     |  8 ++---
 .../fonts/shaping/shape_result_bloberizer.cc  | 12 ++++----
 5 files changed, 29 insertions(+), 25 deletions(-)

diff --git a/content/renderer/render_frame_impl.cc b/content/renderer/render_frame_impl.cc
index a44d75c51ef1e..2ad9a2ceff7ff 100644
--- a/content/renderer/render_frame_impl.cc
+++ b/content/renderer/render_frame_impl.cc
@@ -265,6 +265,7 @@
 // Carbonyl
 #include <stdlib.h>
 #include <iostream>
+#include "carbonyl/src/browser/bridge.h"
 #include "cc/paint/paint_recorder.h"
 #include "cc/paint/skia_paint_canvas.h"
 #include "cc/raster/playback_image_provider.h"
@@ -2303,7 +2304,7 @@ void RenderFrameImpl::Initialize(blink::WebFrame* parent) {
 
   render_callback_ = std::make_shared<std::function<bool()>>(
     [=]() -> bool {
-      if (!IsMainFrame() || IsHidden()) {
+      if (!IsMainFrame() || IsHidden() || carbonyl::Bridge::BitmapMode()) {
         return false;
       }
 
diff --git a/third_party/blink/renderer/core/css/resolver/style_resolver.cc b/third_party/blink/renderer/core/css/resolver/style_resolver.cc
index 686d2d4dab990..728d0bb2d7638 100644
--- a/third_party/blink/renderer/core/css/resolver/style_resolver.cc
+++ b/third_party/blink/renderer/core/css/resolver/style_resolver.cc
@@ -141,6 +141,8 @@
 #include "third_party/blink/renderer/platform/wtf/text/atomic_string_hash.h"
 #include "third_party/blink/renderer/platform/wtf/text/string_builder.h"
 
+#include "carbonyl/src/browser/bridge.h"
+
 namespace blink {
 
 namespace {
@@ -1501,19 +1503,21 @@ const ComputedStyle* StyleResolver::ResolveStyle(
   }
 
   // Carbonyl: force every element to a monospace font sized to fit the
-  // terminal cell grid (11.75/7.0 px wide, 14.0/7.0 px line-height).
-  auto font = state.StyleBuilder().GetFontDescription();
-  FontFamily family;
-
-  family.SetFamily("monospace", FontFamily::Type::kGenericFamily);
-  font.SetFamily(family);
-  font.SetStretch(ExtraExpandedWidthValue());
-  font.SetKerning(FontDescription::kNoneKerning);
-  font.SetComputedSize(11.75 / 7.0);
-  font.SetGenericFamily(FontDescription::kMonospaceFamily);
-  font.SetIsAbsoluteSize(true);
-  state.StyleBuilder().SetFontDescription(font);
-  state.StyleBuilder().SetLineHeight(Length::Fixed(14.0 / 7.0));
+  // terminal cell grid. Skip in bitmap mode where real glyphs render.
+  if (!carbonyl::Bridge::BitmapMode()) {
+    auto font = state.StyleBuilder().GetFontDescription();
+    FontFamily family;
+
+    family.SetFamily("monospace", FontFamily::Type::kGenericFamily);
+    font.SetFamily(family);
+    font.SetStretch(ExtraExpandedWidthValue());
+    font.SetKerning(FontDescription::kNoneKerning);
+    font.SetComputedSize(13.25 / 4.0);
+    font.SetGenericFamily(FontDescription::kMonospaceFamily);
+    font.SetIsAbsoluteSize(true);
+    state.StyleBuilder().SetFontDescription(font);
+    state.StyleBuilder().SetLineHeight(Length::Fixed(16.0 / 4.0));
+  }
 
   state.LoadPendingResources();
 
diff --git a/third_party/blink/renderer/platform/BUILD.gn b/third_party/blink/renderer/platform/BUILD.gn
index 87f64f5c2cfd4..7fc654b99c76c 100644
--- a/third_party/blink/renderer/platform/BUILD.gn
+++ b/third_party/blink/renderer/platform/BUILD.gn
@@ -1807,6 +1807,7 @@ component("platform") {
     "//base:base_static",
     "//base/allocator:buildflags",
     "//build:chromecast_buildflags",
+    "//carbonyl/src/browser:carbonyl",
     "//cc",
     "//cc/ipc",
     "//cc/mojo_embedder",
diff --git a/third_party/blink/renderer/platform/fonts/font.cc b/third_party/blink/renderer/platform/fonts/font.cc
index 420cf7860556b..e76dacea29171 100644
--- a/third_party/blink/renderer/platform/fonts/font.cc
+++ b/third_party/blink/renderer/platform/fonts/font.cc
@@ -45,11 +45,9 @@
 #include "third_party/blink/renderer/platform/wtf/text/unicode.h"
 #include "ui/gfx/geometry/rect_f.h"
 
-namespace blink {
+#include "carbonyl/src/browser/bridge.h"
 
-// Carbonyl: gate Blink text rendering to emit base64-encoded raw text instead
-// of HarfBuzz-shaped glyphs, so the terminal can decode and place the text.
-static const bool carbonyl_b64_text = true;
+namespace blink {
 
 namespace {
 
@@ -106,7 +104,7 @@ void Font::DrawText(cc::PaintCanvas* canvas,
   if (ShouldSkipDrawing())
     return;
 
-  if (carbonyl_b64_text) {
+  if (!carbonyl::Bridge::BitmapMode()) {
     auto string = StringView(
       text_info.text,
       text_info.from,
diff --git a/third_party/blink/renderer/platform/fonts/shaping/shape_result_bloberizer.cc b/third_party/blink/renderer/platform/fonts/shaping/shape_result_bloberizer.cc
index ed517dabedd66..76d15d6ff24f3 100644
--- a/third_party/blink/renderer/platform/fonts/shaping/shape_result_bloberizer.cc
+++ b/third_party/blink/renderer/platform/fonts/shaping/shape_result_bloberizer.cc
@@ -4,6 +4,8 @@
 
 #include "third_party/blink/renderer/platform/fonts/shaping/shape_result_bloberizer.h"
 
+#include "carbonyl/src/browser/bridge.h"
+
 #include <hb.h>
 
 #include <algorithm>
@@ -608,17 +610,15 @@ float ShapeResultBloberizer::FillFastHorizontalGlyphs(const ShapeResult* result,
                               static_cast<void*>(this));
 }
 
-// Carbonyl: when text mode is on, Font::DrawText already emits base64-encoded
-// raw text via its own path. Bloberizer-based callers (DrawEmphasisMarks,
-// plain_text_painter) would re-emit shaped glyphs on top, so short-circuit.
-static const bool carbonyl_b64_text = true;
-
 void DrawTextBlobs(const ShapeResultBloberizer::BlobBuffer& blobs,
                    cc::PaintCanvas& canvas,
                    const gfx::PointF& point,
                    const cc::PaintFlags& flags,
                    cc::NodeId node_id) {
-  if (carbonyl_b64_text) {
+  // Carbonyl: when text mode is on, Font::DrawText already emits base64 raw
+  // text via its own path; bloberizer-based callers would re-emit shaped
+  // glyphs on top of it. Suppress everything except bitmap mode.
+  if (!carbonyl::Bridge::BitmapMode()) {
     return;
   }
 
