new file mode 100644
index 0000000000000..1bcd85f9eca53
--- /dev/null
+++ b/third_party/blink/renderer/core/exported/carbonyl_text_capture.cc
@@ -0,0 +1,259 @@
+// Copyright 2026 The Carbonyl Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license.
+
+#include "third_party/blink/public/web/carbonyl_text_capture.h"
+
+#include <cstdint>
+#include <memory>
+#include <vector>
+
+#include "base/base64.h"
+#include "third_party/blink/renderer/platform/allow_discouraged_type.h"
+#include "third_party/blink/renderer/core/exported/web_view_impl.h"
+#include "third_party/blink/renderer/core/frame/local_frame.h"
+#include "third_party/blink/renderer/core/frame/local_frame_view.h"
+#include "third_party/blink/renderer/core/frame/web_local_frame_impl.h"
+#include "third_party/skia/include/core/SkBlendMode.h"
+#include "third_party/skia/include/core/SkCanvas.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "third_party/skia/include/core/SkImageInfo.h"
+#include "third_party/skia/include/core/SkM44.h"
+#include "third_party/skia/include/core/SkMatrix.h"
+#include "third_party/skia/include/core/SkMesh.h"
+#include "third_party/skia/include/core/SkPaint.h"
+#include "third_party/skia/include/core/SkRect.h"
+#include "third_party/skia/include/core/SkRefCnt.h"
+#include "third_party/skia/include/core/SkSurfaceProps.h"
+#include "third_party/skia/include/core/SkVertices.h"
+#include "third_party/skia/include/private/base/SkTemplates.h"
+#include "third_party/skia/src/base/SkBase64.h"
+#include "third_party/skia/src/core/SkClipStackDevice.h"
+#include "third_party/skia/src/core/SkDevice.h"
+#include "third_party/skia/src/core/SkFontPriv.h"
+#include "third_party/skia/src/text/GlyphRun.h"
+#include "ui/gfx/geometry/rect_f.h"
+#include "ui/gfx/geometry/skia_conversions.h"
+
+namespace blink {
+namespace {
+
+// A captured text run. Held in `TextCaptureDevice::data_` and replayed up the
+// device stack so the final root device has every text run with its absolute
+// document-space bounds.
+struct CapturedRun {
+  std::string text;
+  gfx::RectF bounds;
+  uint32_t color;
+};
+
+
+// Custom Skia device that intercepts paint operations on the document's paint
+// record and accumulates decoded text runs.
+//
+// Font::DrawText (when not in bitmap mode) emits each text run as an
+// SkTextBlob built from a base64 string in place of the shaped glyphs. This
+// device's `onDrawGlyphRunList` decodes that base64 back to UTF-8.
+//
+// Layer/saveLayer support is provided by `createDevice` returning child
+// devices of the same type; `drawDevice` then re-anchors each child's
+// captured runs into this device's coordinate space using the relative
+// transform, so the final root device ends up with every run in absolute
+// document coordinates.
+class TextCaptureDevice : public SkClipStackDevice {
+ public:
+  TextCaptureDevice(const SkImageInfo& info, const SkSurfaceProps& props)
+      : SkClipStackDevice(info, props) {
+    ClearRect(SkRect::MakeWH(info.width(), info.height()));
+  }
+
+  void Reset() { data_.clear(); }
+
+  void Drain(std::vector<CapturedRun>* out) {
+    out->swap(data_);
+    data_.clear();
+  }
+
+ protected:
+  sk_sp<SkDevice> createDevice(const CreateInfo& info,
+                               const SkPaint*) override {
+    return sk_sp<SkDevice>(sk_make_sp<TextCaptureDevice>(
+        info.fInfo, SkSurfaceProps(0, info.fPixelGeometry)));
+  }
+
+  void drawDevice(SkDevice* base_device,
+                  const SkSamplingOptions&,
+                  const SkPaint& paint) override {
+    if (IsUnsupportedPaint(paint)) {
+      return;
+    }
+    auto blend = paint.getBlendMode_or(SkBlendMode::kClear);
+    if (blend != SkBlendMode::kSrc && blend != SkBlendMode::kSrcOver) {
+      return;
+    }
+    auto* device = static_cast<TextCaptureDevice*>(base_device);
+    // M148: getRelativeTransform returns SkM44; pull the 3x3 affine portion.
+    SkMatrix transform = device->getRelativeTransform(*this).asM33();
+    for (const auto& run : device->data_) {
+      data_.push_back(CapturedRun{
+          run.text,
+          gfx::SkRectToRectF(transform.mapRect(gfx::RectFToSkRect(run.bounds))),
+          run.color,
+      });
+    }
+  }
+
+  void drawPaint(const SkPaint&) override {}
+  void drawOval(const SkRect&, const SkPaint&) override {}
+  void drawPoints(SkCanvas::PointMode,
+                  SkSpan<const SkPoint>,
+                  const SkPaint&) override {}
+  void drawImageRect(const SkImage*,
+                     const SkRect*,
+                     const SkRect&,
+                     const SkSamplingOptions&,
+                     const SkPaint&,
+                     SkCanvas::SrcRectConstraint) override {}
+
+  void drawVertices(const SkVertices* vertices,
+                    sk_sp<SkBlender>,
+                    const SkPaint& paint,
+                    bool /*skip_color_xform*/) override {
+    DrawSkRect(vertices->bounds(), paint);
+  }
+
+  void drawMesh(const SkMesh& mesh,
+                sk_sp<SkBlender>,
+                const SkPaint& paint) override {
+    DrawSkRect(mesh.bounds(), paint);
+  }
+
+  void drawPath(const SkPath& path, const SkPaint& paint) override {
+    DrawSkRect(path.getBounds(), paint);
+  }
+
+  void drawRRect(const SkRRect& rect, const SkPaint& paint) override {
+    DrawSkRect(rect.rect(), paint);
+  }
+
+  void drawRect(const SkRect& rect, const SkPaint& paint) override {
+    DrawSkRect(rect, paint);
+  }
+
+  void onDrawGlyphRunList(SkCanvas*,
+                          const sktext::GlyphRunList& glyph_run_list,
+                          const SkPaint& paint) override {
+    SkPoint position = ToDevice(glyph_run_list.origin());
+
+    for (const auto& glyph_run : glyph_run_list) {
+      size_t run_size = glyph_run.runSize();
+
+      // Decode the per-glyph "unichar" stream back into the base64 string
+      // that Font::DrawText emitted. SkFontPriv::GlyphsToUnichars maps glyph
+      // ids back to their source codepoints; we only ever pushed printable
+      // ASCII into the SkTextBlob so each unichar fits in a single byte.
+      skia_private::AutoSTArray<64, SkUnichar> unichars(run_size);
+      SkFontPriv::GlyphsToUnichars(glyph_run.font(),
+                                   glyph_run.glyphsIDs().data(), run_size,
+                                   unichars.get());
+
+      // Build the base64 string in a std::string so writes go through bounds-
+      // checked container methods rather than raw pointer indexing.
+      std::string base64;
+      base64.resize(run_size);
+      for (size_t i = 0; i < run_size; ++i) {
+        base64[i] = static_cast<char>(unichars[i]);
+      }
+
+      size_t decoded_size = 0;
+      if (SkBase64::Decode(base64.data(), run_size, nullptr, &decoded_size) !=
+          SkBase64::kNoError) {
+        return;
+      }
+      std::string utf8;
+      utf8.resize(decoded_size);
+      if (SkBase64::Decode(base64.data(), run_size, utf8.data(),
+                           &decoded_size) != SkBase64::kNoError) {
+        return;
+      }
+      utf8.resize(decoded_size);
+
+      data_.push_back(CapturedRun{
+          std::move(utf8),
+          gfx::RectF(position.x(), position.y(), 0, 0),
+          paint.getColor(),
+      });
+    }
+  }
+
+ private:
+  // Add a zero-content run marking an opaque-filled rect. The terminal-side
+  // renderer uses these as "clear this region" instructions so that text
+  // drawn below an overdrawn rect doesn't leak through.
+  void ClearRect(const SkRect& rect) {
+    data_.push_back(CapturedRun{std::string(), gfx::SkRectToRectF(rect), 0});
+  }
+
+  // localToDevice() already returns the SkMatrix (3x3) form; only the
+  // SkM44 returned by getRelativeTransform needs the .asM33() collapse.
+  SkRect ToDevice(const SkRect& rect) { return localToDevice().mapRect(rect); }
+  SkPoint ToDevice(const SkPoint& point) {
+    return localToDevice().mapPoint(point);
+  }
+
+  bool IsUnsupportedPaint(const SkPaint& paint) {
+    return paint.getShader() || paint.getBlender() || paint.getPathEffect() ||
+           paint.getMaskFilter() || paint.getImageFilter() ||
+           paint.getColorFilter();
+  }
+
+  void DrawSkRect(const SkRect& rect, const SkPaint& paint) {
+    if (paint.getStyle() == SkPaint::Style::kFill_Style &&
+        paint.getAlphaf() == 1.0f && !IsUnsupportedPaint(paint)) {
+      auto blend = paint.getBlendMode_or(SkBlendMode::kClear);
+      if (blend == SkBlendMode::kSrc || blend == SkBlendMode::kSrcOver) {
+        ClearRect(ToDevice(rect));
+      }
+    }
+  }
+
+  // Short-lived buffer ferrying captured runs out through the public callback;
+  // not retained beyond CaptureTerminalText. Suppress the blink-style
+  // std::vector-as-data-member warning explicitly.
+  std::vector<CapturedRun> data_ ALLOW_DISCOURAGED_TYPE("Carbonyl text capture");
+};
+
+}  // namespace
+
+void CaptureTerminalText(
+    WebView* view,
+    int width,
+    int height,
+    base::FunctionRef<void(const std::string& text,
+                           const gfx::RectF& bounds,
+                           uint32_t color)> emit) {
+  if (!view || width <= 0 || height <= 0) {
+    return;
+  }
+
+  auto* impl = static_cast<WebViewImpl*>(view);
+  if (!impl->MainFrameImpl() || !impl->MainFrameImpl()->GetFrame() ||
+      !impl->MainFrameImpl()->GetFrame()->View()) {
+    return;
+  }
+
+  auto device = sk_make_sp<TextCaptureDevice>(
+      SkImageInfo::MakeUnknown(width, height),
+      SkSurfaceProps(0, kUnknown_SkPixelGeometry));
+  // Use brace-init to avoid the most-vexing-parse warning.
+  SkCanvas canvas{sk_sp<SkDevice>(device)};
+
+  impl->MainFrameImpl()->GetFrame()->View()->GetPaintRecord().Playback(&canvas);
+
+  std::vector<CapturedRun> runs;
+  device->Drain(&runs);
+  for (auto& run : runs) {
+    emit(run.text, run.bounds, run.color);
+  }
+}
+
+}  // namespace blink
